# Installed on the droplet as /etc/anthemic-contact/contact.env (mode 640).
# CI writes incoming-hub/private/contact.env from GitHub Actions secrets.

SLACK_WEBHOOK_URL=
CONTACT_ADMIN_TOKEN=
CONTACT_CORS_ORIGIN=https://anthemic-developments.com,https://www.anthemic-developments.com
# Optional: CONTACT_ADMIN_RATE_MAX=60 CONTACT_ADMIN_RATE_WINDOW_MS=3600000
